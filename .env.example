# Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Option 1: Local PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/apecglobal"

# Option 2: Supabase (recommended for production)
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Option 3: Neon (serverless PostgreSQL)
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/apecglobal?sslmode=require"

# ============================================
# AUTH
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"
JWT_SECRET="your-jwt-secret-key-change-in-production"

# ============================================
# ADMIN
# ============================================
ADMIN_EMAIL="admin@apecglobal.vn"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Super Admin"

# ============================================
# MEDIA / CLOUDINARY (optional)
# ============================================
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# ============================================
# EMAIL (optional - for contact form notifications)
# ============================================
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="APEC GLOBAL <noreply@apecglobal.vn>"
# EMAIL_TO="info@apecglobal.vn"

# ============================================
# APP CONFIG
# ============================================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="APEC GLOBAL"
NODE_ENV="development"
